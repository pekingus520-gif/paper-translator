{
  "manifest_version": 2,
  "name": "Paper Translator Reader Bridge",
  "version": "0.2.7",
  "description": "将 Zotero 阅读器选区及有限上下文传给本机 Paper Translator。",
  "author": "Paper Translator",
  "applications": {
    "zotero": {
      "id": "paper-translator@local",
      "strict_min_version": "7.0",
      "strict_max_version": "9.0.*",
      "update_url": "https://paper-translator.invalid/zotero/updates.json"
    }
  }
}
